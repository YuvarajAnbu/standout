NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/standout
MONGODB_POOL_SIZE=10
# Comma-separated DNS servers for mongodb+srv, or "system" to use OS DNS.
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
JWT_SECRET=replace-with-a-long-random-secret
BCRYPT_ROUNDS=12
REQUEST_BODY_LIMIT=25mb
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
BRAINTREE_ENVIRONMENT=sandbox
SANDBOX_MERCHANT_ID=replace-me
SANDBOX_PUBLIC_KEY=replace-me
SANDBOX_PRIVATE_KEY=replace-me
# Production deployments may use these names instead of the SANDBOX_* names.
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=
